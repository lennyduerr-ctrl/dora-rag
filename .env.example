# OpenRouter — one key powers BOTH the chat model and the embeddings.
# Get a free key at https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-...
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Chat model (any OpenRouter model id works; this is fast & cheap)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Embedding model — MUST match the model used to build data/dora_vectors.npy.
# If you change this, rebuild the vector store with `python -m src.ingest`.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=dora-rag
# LANGSMITH_TRACING=true
